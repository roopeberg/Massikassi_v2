# Copy this file to `.env` and you're done — the defaults below work as-is for
# local development (`npm run setup` && `npm run dev`).

# --- Local development ---
# Matches the Postgres container started by `npm run db:up` (POSTGRES_PASSWORD
# below is the password of that container, so keep the two in sync).
DATABASE_URL=postgres://massikassi:change-me@localhost:5432/massikassi

# --- Postgres container (used by both dev and the deploy) ---
# A real password — this ends up in the db container, not just an example.
# Fine to leave as-is locally; change it for the real deploy (see DEPLOY.md).
POSTGRES_PASSWORD=change-me

# --- Only used by the deploy (see DEPLOY.md) ---
# The domain that resolves (A record) to this machine's static public IP.
# Caddy uses it to request a Let's Encrypt certificate automatically.
# Unused in local dev, but docker compose wants it set to parse the file.
DOMAIN=massikassi.example.com
