# Local `npm run dev` (no Docker) — points at whatever Postgres you're running yourself.
DATABASE_URL=postgres://localhost:5432/massikassi

# --- Only used by docker-compose.yml (self-hosted deploy, see DEPLOY.md) ---
# A real password — this ends up in the db container, not just an example.
POSTGRES_PASSWORD=change-me
# The domain that resolves (A record) to this machine's static public IP.
# Caddy uses it to request a Let's Encrypt certificate automatically. Also
# doubles as the recovery-email sending domain (DKIM/SPF, see DEPLOY.md) and
# the base URL used in confirmation/recovery links.
DOMAIN=massikassi.example.com
# A long random secret used to key recovery-email lookups (HMAC-SHA256) so
# email addresses are never stored in plaintext — see lib/recovery-email.ts.
# Generate one with: openssl rand -hex 32
# Changing this after emails are attached invalidates all of them (their
# email_key won't match anymore) — treat it like a real secret, back it up,
# don't rotate it casually.
EMAIL_HMAC_SECRET=change-me
